# Copie a .env en la raíz del repo (Docker Compose lo carga).

# Puerto publicado de la API. Si 8080 está ocupado (IIS, otro Docker, etc.), use 8081 u otro.
# API_PORT=8081

# Secreto para firmar JWT (producción: valor largo y aleatorio)
# JWT_SECRET=...

# Solo si usa docker-compose.with-static-frontend.yml:
# STATIC_WEB_PORT=3000

# Copie a frontend/.env. Debe coincidir con API_PORT del .env de la raíz (mismo número de puerto).
# Si la API usa 8081:
# Desarrollo local (sin barra final)
# VITE_API_ORIGIN=http://127.0.0.1:8081
VITE_API_ORIGIN=http://127.0.0.1:8080

# Producción (Render u otro): URL pública del servicio de la API, ej.
# VITE_API_ORIGIN=https://electoral-api-xxxx.onrender.com
